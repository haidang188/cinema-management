USE cinema_management;

SET @previous_sql_safe_updates := @@SQL_SAFE_UPDATES;
SET SQL_SAFE_UPDATES = 0;

-- =====================================================
-- 1. Lấy phim đang chiếu
-- =====================================================

SET @movie_1 := (
    SELECT id
    FROM movies
    WHERE UPPER(status) = 'SHOWING'
    ORDER BY id
    LIMIT 1
);

SET @movie_2 := (
    SELECT id
    FROM movies
    WHERE UPPER(status) = 'SHOWING'
      AND id <> @movie_1
    ORDER BY id
    LIMIT 1
);

SET @movie_3 := (
    SELECT id
    FROM movies
    WHERE UPPER(status) = 'SHOWING'
      AND id NOT IN (@movie_1, COALESCE(@movie_2, -1))
    ORDER BY id
    LIMIT 1
);

-- Nếu database chỉ có một hoặc hai phim đang chiếu thì dùng lại phim đã có.
SET @movie_2 := COALESCE(@movie_2, @movie_1);
SET @movie_3 := COALESCE(@movie_3, @movie_1);


-- =====================================================
-- 2. Lấy phòng đang hoạt động
-- =====================================================

SET @room_1 := (
    SELECT id
    FROM cinema_rooms
    WHERE UPPER(COALESCE(status, 'ACTIVE')) = 'ACTIVE'
    ORDER BY id
    LIMIT 1
);

SET @room_2 := (
    SELECT id
    FROM cinema_rooms
    WHERE UPPER(COALESCE(status, 'ACTIVE')) = 'ACTIVE'
      AND id <> @room_1
    ORDER BY id
    LIMIT 1
);

SET @room_3 := (
    SELECT id
    FROM cinema_rooms
    WHERE UPPER(COALESCE(status, 'ACTIVE')) = 'ACTIVE'
      AND id NOT IN (@room_1, COALESCE(@room_2, -1))
    ORDER BY id
    LIMIT 1
);

-- Nếu không đủ ba phòng thì dùng lại phòng đầu.
SET @room_2 := COALESCE(@room_2, @room_1);
SET @room_3 := COALESCE(@room_3, @room_1);


-- =====================================================
