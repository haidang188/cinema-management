-- =====================================================
-- 4. Thêm suất chiếu
--
-- Cộng thêm 15 phút vào thời lượng phim để tránh hai suất
-- trong cùng phòng nằm quá sát nhau.
-- =====================================================

INSERT INTO showtimes (
    movie_id,
    room_id,
    format,
    start_time,
    end_time,
    status,
    created_at
)
SELECT
    schedule.movie_id,
    schedule.room_id,
    schedule.format_name,
    TIMESTAMP(
        DATE_ADD(CURDATE(), INTERVAL schedule.day_offset DAY),
        schedule.start_at
    ),
    DATE_ADD(
        TIMESTAMP(
            DATE_ADD(CURDATE(), INTERVAL schedule.day_offset DAY),
            schedule.start_at
        ),
        INTERVAL movie.duration_minutes MINUTE
    ),
    'OPEN',
    NOW()
FROM test_showtime_schedule AS schedule
JOIN movies AS movie
    ON movie.id = schedule.movie_id
JOIN cinema_rooms AS room
    ON room.id = schedule.room_id
WHERE schedule.movie_id IS NOT NULL
  AND schedule.room_id IS NOT NULL
  AND UPPER(movie.status) = 'SHOWING'
  AND UPPER(COALESCE(room.status, 'ACTIVE')) = 'ACTIVE'

  -- Không tạo nếu cùng phòng đã có suất bị chồng thời gian.
  AND NOT EXISTS (
      SELECT 1
      FROM showtimes AS existing_showtime
      WHERE existing_showtime.room_id = schedule.room_id
        AND existing_showtime.status <> 'CANCELLED'
        AND existing_showtime.start_time <
            DATE_ADD(
                TIMESTAMP(
                    DATE_ADD(CURDATE(), INTERVAL schedule.day_offset DAY),
                    schedule.start_at
                ),
                INTERVAL movie.duration_minutes + 15 MINUTE
            )
        AND existing_showtime.end_time >
            DATE_SUB(
                TIMESTAMP(
                    DATE_ADD(CURDATE(), INTERVAL schedule.day_offset DAY),
                    schedule.start_at
                ),
                INTERVAL 15 MINUTE
            )
  );


-- =====================================================
-- 5. Tạo trạng thái ghế cho tất cả suất chiếu vừa có
-- =====================================================

INSERT IGNORE INTO showtime_seats (
    showtime_id,
    seat_id,
    status,
    held_until,
    hold_owner
)
SELECT
    showtime.id,
    seat.id,
    'AVAILABLE',
    NULL,
    NULL
FROM showtimes AS showtime
JOIN cinema_rooms AS room
    ON room.id = showtime.room_id
JOIN seats AS seat
    ON seat.room_id = room.id
WHERE showtime.start_time >= CURDATE()
  AND showtime.start_time < DATE_ADD(CURDATE(), INTERVAL 5 DAY)
  AND UPPER(showtime.status) = 'OPEN'
  AND UPPER(COALESCE(room.status, 'ACTIVE')) = 'ACTIVE'
  AND UPPER(COALESCE(seat.status, 'ACTIVE')) = 'ACTIVE';


DROP TEMPORARY TABLE IF EXISTS test_showtime_schedule;

SET SQL_SAFE_UPDATES = @previous_sql_safe_updates;


-- =====================================================
-- 6. Kiểm tra kết quả
-- =====================================================

SELECT
    showtime.id,
    movie.title AS movie_title,
    room.name AS room_name,
    showtime.format,
    showtime.start_time,
    showtime.end_time,
    showtime.status,
    COUNT(showtime_seat.id) AS available_seat_records
FROM showtimes AS showtime
JOIN movies AS movie
    ON movie.id = showtime.movie_id
JOIN cinema_rooms AS room
    ON room.id = showtime.room_id
LEFT JOIN showtime_seats AS showtime_seat
    ON showtime_seat.showtime_id = showtime.id
WHERE showtime.start_time >= CURDATE()
  AND showtime.start_time < DATE_ADD(CURDATE(), INTERVAL 5 DAY)
GROUP BY
    showtime.id,
    movie.title,
    room.name,
    showtime.format,
    showtime.start_time,
    showtime.end_time,
    showtime.status
ORDER BY showtime.start_time;